{
  "schemaVersion": 2,
  "id": "skill-static-website",
  "name": "Static Website",
  "version": "1.1.1",
  "description": "Static-site implementation variation for producing servable HTML/CSS sites with deterministic scaffolding and validation. Composes web engineering and software foundations; it does not define all websites.",
  "author": {
    "name": "Chainabit"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/chainabit/plugins/tree/main/web/skill-static-website",
  "categories": [
    "code"
  ],
  "keywords": [
    "static-site",
    "html",
    "css",
    "website",
    "landing-page"
  ],
  "compatibility": {
    "minVersion": "0.9.0"
  },
  "components": {
    "skills": [
      "skills/static-website"
    ]
  },
  "composition": {
    "requires": [
      "skill-software-engineering",
      "skill-project-bootstrap",
      "skill-git",
      "skill-project-documentation",
      "skill-web-engineering"
    ],
    "role": "implementation"
  },
  "permissions": {
    "network": [],
    "filesystem": [],
    "shell": false,
    "execute": true,
    "dangerousSkipPermissions": false,
    "permissionModelVersion": 2,
    "requested": [
      "sandbox.execute"
    ]
  },
  "validators": [
    {
      "id": "skill-static-website.validate_site",
      "entrypoint": "skills/static-website/scripts/validate_site.py",
      "runtime": "python3",
      "validationClass": "content_present",
      "protocol": "chainabit.website.validation/v1",
      "target": {"kind": "tree", "extensions": []}
    }
  ],
  "diagnostics": [
    {
      "entrypoint": "skills/static-website/scripts/scaffold_site.py",
      "inputErrorExitCodes": [1]
    },
    {
      "entrypoint": "skills/static-website/scripts/validate_site.py",
      "inputErrorExitCodes": [1]
    }
  ],
  "produces": ["static-website"],
  "requires": {
    "python": [],
    "binaries": ["python3"],
    "fonts": ["IBM Plex Sans"]
  },
  "dependencies": {
    "required": {
      "python": [],
      "binaries": ["python3"],
      "fonts": ["IBM Plex Sans"]
    },
    "optional": {}
  },
  "artifactContract": {
    "formats": [
      {
        "format": "static-website",
        "outputShape": "tree",
        "mimeType": "application/vnd.chainabit.static-site",
        "validatorId": "skill-static-website.validate_site",
        "validatorProtocol": "chainabit.website.validation/v1",
        "minimumValidationClass": "content_present"
      }
    ],
    "generators": [
      {
        "id": "skill-static-website.scaffold",
        "runtime": "python3",
        "entrypoint": "skills/static-website/scripts/scaffold_site.py",
        "outputArgumentIndex": 4,
        "protocol": "chainabit.website.execution/v1",
        "formats": ["static-website"]
      }
    ]
  },
  "typography": {
    "defaultFamily": "IBM Plex Sans",
    "userOverride": true,
    "fallbackFamilies": ["IBM Plex Sans Arabic"],
    "runtimeFamilyEnv": "CHAINABIT_ARTIFACT_FONT_FAMILY",
    "runtimeAssetDirEnv": "CHAINABIT_ARTIFACT_FONT_DIR"
  }
}
