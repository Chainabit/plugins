{
  "schemaVersion": 2,
  "id": "skill-pdf",
  "name": "PDF Generation Skill",
  "version": "3.1.0",
  "description": "Produces real PDF files from Markdown or from a JSON document spec, and validates the result. Ships three Python scripts that run in the sandbox against the pre-installed WeasyPrint and ReportLab toolchain; no network access at any point.",
  "author": {
    "name": "NEXUS Community"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/chainabit/plugins/tree/main/skill-pdf",
  "categories": [
    "productivity",
    "data"
  ],
  "keywords": [
    "skill",
    "pdf",
    "generation",
    "markdown",
    "report",
    "weasyprint",
    "reportlab"
  ],
  "compatibility": {
    "minVersion": "0.9.0"
  },
  "components": {
    "skills": [
      "skills/pdf"
    ]
  },
  "permissions": {
    "network": [],
    "filesystem": [],
    "shell": false,
    "execute": true,
    "dangerousSkipPermissions": false
  },
  "validators": [
    {
      "id": "skill-pdf.validate_pdf",
      "entrypoint": "skills/pdf/scripts/validate_pdf.py",
      "runtime": "python3",
      "validationClass": "content_present",
      "target": {
        "kind": "file",
        "extensions": [
          ".pdf"
        ]
      }
    }
  ],
  "diagnostics": [
    {
      "entrypoint": "skills/pdf/scripts/md_to_pdf.py",
      "inputErrorExitCodes": [
        1
      ]
    },
    {
      "entrypoint": "skills/pdf/scripts/report_pdf.py",
      "inputErrorExitCodes": [
        1
      ]
    },
    {
      "entrypoint": "skills/pdf/scripts/validate_pdf.py",
      "inputErrorExitCodes": [
        1
      ]
    }
  ],
  "produces": [
    ".pdf"
  ],
  "requires": {
    "python": [
      "markdown",
      "weasyprint",
      "reportlab"
    ],
    "binaries": [
      "python3"
    ],
    "fonts": [
      "DejaVuSans"
    ]
  }
}
