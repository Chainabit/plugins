{
  "schemaVersion": 1,
  "id": "provider-solongate",
  "name": "SolonGate",
  "version": "0.58.0",
  "description": "Security proxy and MCP gateway that mediates, filters, and audits AI agent tool calls before they run.",
  "author": {
    "name": "SolonGate",
    "url": "https://solongate.com"
  },
  "license": "MIT",
  "homepage": "https://solongate.com",
  "categories": ["security", "providers"],
  "keywords": ["provider", "proxy", "mcp", "gateway", "security", "audit"],
  "compatibility": {
    "minVersion": "1.0.0"
  },
  "components": {
    "mcpServers": [
      {
        "name": "solongate-proxy",
        "command": "solongate-proxy",
        "args": ["--stdio"],
        "env": {
          "SOLONGATE_MODE": "guard"
        }
      }
    ]
  },
  "permissions": {
    "network": ["solongate.com"],
    "filesystem": ["~/.solongate"],
    "shell": true,
    "dangerousSkipPermissions": false
  },
  "install": {
    "postInstall": "npm install -g @solongate/proxy",
    "uninstall": "npm uninstall -g @solongate/proxy"
  }
}
