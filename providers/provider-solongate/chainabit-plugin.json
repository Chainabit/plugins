{
  "schemaVersion": 1,
  "id": "provider-solongate",
  "name": "SolonGate",
  "version": "0.58.0",
  "description": "Security proxy and MCP gateway that mediates, filters, and audits AI agent tool calls before they run.",
  "author": {
    "name": "SolonGate",
    "url": "https://solongate.com"
  },
  "license": "MIT",
  "homepage": "https://solongate.com",
  "categories": [
    "security",
    "providers"
  ],
  "keywords": [
    "provider",
    "proxy",
    "mcp",
    "gateway",
    "security",
    "audit"
  ],
  "compatibility": {
    "minVersion": "1.0.0"
  },
  "components": {
    "mcpServers": [
      {
        "name": "solongate-proxy",
        "command": "solongate-proxy",
        "args": [
          "--stdio"
        ],
        "env": {
          "SOLONGATE_MODE": "guard"
        }
      }
    ]
  },
  "permissions": {
    "network": [
      "solongate.com"
    ],
    "filesystem": [
      "~/.solongate"
    ],
    "shell": false,
    "dangerousSkipPermissions": false,
    "permissionModelVersion": 2,
    "requested": [
      "host.process.execute",
      "network.connect",
      "filesystem.read",
      "lifecycle.install",
      "host.package.install"
    ]
  },
  "installation": {
    "packages": [
      {
        "manager": "npm",
        "name": "@solongate/proxy",
        "version": "0.58.0",
        "integrity": "sha512-ZFdIz4Dn3TbyzmKN80kLSPTnzuE0MLgC4Cv80OlP6wtwIC6rwWolACPEWXXqE7/FEjWh4cMLMEDsBZMs6LDMwQ==",
        "scope": "global",
        "executables": ["solongate-proxy"]
      }
    ]
  }
}
