{
  "schemaVersion": 1,
  "id": "provider-codegraph",
  "name": "CodeGraph",
  "version": "1.5.0",
  "description": "Local-first, Tree-sitter-based code intelligence: indexes a codebase into a SQLite graph of symbols and call/reference/definition edges, giving agents surgical source context in one MCP call instead of a grep/read loop.",
  "author": {
    "name": "Colby Mchenry",
    "url": "https://github.com/colbymchenry"
  },
  "license": "MIT",
  "homepage": "https://colbymchenry.github.io/codegraph/",
  "categories": [
    "code",
    "providers"
  ],
  "keywords": [
    "provider",
    "code-intelligence",
    "mcp",
    "tree-sitter",
    "code-graph",
    "indexing",
    "local-first",
    "sqlite"
  ],
  "compatibility": {
    "minVersion": "1.0.0"
  },
  "components": {
    "mcpServers": [
      {
        "name": "codegraph",
        "command": "codegraph",
        "args": [
          "serve",
          "--mcp"
        ],
        "env": {
          "DO_NOT_TRACK": "1"
        }
      }
    ]
  },
  "permissions": {
    "network": [],
    "filesystem": [],
    "shell": true,
    "workspaceAccess": true,
    "dangerousSkipPermissions": false
  },
  "install": {
    "postInstall": "npm install -g @colbymchenry/codegraph",
    "uninstall": "npm uninstall -g @colbymchenry/codegraph"
  }
}
