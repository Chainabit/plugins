{
  "schemaVersion": 1,
  "id": "provider-codegraph",
  "name": "CodeGraph",
  "version": "1.5.0",
  "description": "Local-first, Tree-sitter-based code intelligence: indexes a codebase into a SQLite graph of symbols and call/reference/definition edges, giving agents surgical source context in one MCP call instead of a grep/read loop.",
  "author": {
    "name": "Colby Mchenry",
    "url": "https://github.com/colbymchenry"
  },
  "license": "MIT",
  "homepage": "https://colbymchenry.github.io/codegraph/",
  "categories": [
    "code",
    "providers"
  ],
  "keywords": [
    "provider",
    "code-intelligence",
    "mcp",
    "tree-sitter",
    "code-graph",
    "indexing",
    "local-first",
    "sqlite"
  ],
  "compatibility": {
    "minVersion": "1.0.0"
  },
  "components": {
    "mcpServers": [
      {
        "name": "codegraph",
        "command": "codegraph",
        "args": [
          "serve",
          "--mcp"
        ],
        "env": {
          "DO_NOT_TRACK": "1"
        }
      }
    ]
  },
  "permissions": {
    "network": [],
    "filesystem": [],
    "shell": false,
    "workspaceAccess": true,
    "dangerousSkipPermissions": false,
    "permissionModelVersion": 2,
    "requested": [
      "host.process.execute",
      "workspace.read",
      "lifecycle.install",
      "host.package.install"
    ]
  },
  "installation": {
    "packages": [
      {
        "manager": "npm",
        "name": "@colbymchenry/codegraph",
        "version": "1.5.0",
        "integrity": "sha512-/l1JMVOQ9WGQLrc/IIuAg7Igr944t79/oNCJTcnGkYtIeQx2XFIqI0ho+9Les/Yu4zKfmPU17hIUshD6yP1fKw==",
        "scope": "global",
        "executables": ["codegraph"]
      }
    ]
  }
}
