      "inputErrorExitCodes": [
        1
      ]
    },
    {
      "entrypoint": "skills/pdf/scripts/validate_pdf.py",
      "inputErrorExitCodes": [
        1
      ]
    }
  ],
  "produces": [
    ".pdf"
  ],
  "requires": {
    "python": [],
    "binaries": [
      "python3"
    ],
    "fonts": []
  },
  "dependencies": {
    "required": {
      "python": [],
      "binaries": [
        "python3"
      ],
      "fonts": []
    },
    "optional": {}
  },
  "capabilities": {
    "declared": [
      {
        "id": "skill-pdf.core",
        "kind": "skill",
        "verifiedBehaviors": [
          "declared bundle behavior"
        ]
      }
    ],
    "requested": []
