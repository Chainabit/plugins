{
  "schemaVersion": 2,
  "id": "skill-pdf",
  "name": "PDF Generation Skill",
  "version": "5.0.0",
  "description": "Produces and verifies secure, quality-first PDFs through explicit capability selection with optional professional rendering and manipulation adapters.",
  "author": {
    "name": "NEXUS Community"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/chainabit/plugins/tree/main/artifacts/skill-pdf",
  "categories": [
    "productivity",
    "data"
  ],
  "keywords": [
    "skill",
    "pdf",
    "generation",
    "markdown",
    "report",
    "PIL"
  ],
  "compatibility": {
