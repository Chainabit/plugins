{
  "schemaVersion": 2,
  "id": "skill-pdf",
  "name": "PDF Generation Skill",
  "version": "5.2.3",
  "description": "Produces and verifies secure, quality-first PDFs through explicit capability selection with optional professional rendering and manipulation adapters.",
  "author": {
    "name": "NEXUS Community"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/chainabit/plugins/tree/main/artifacts/skill-pdf",
  "categories": [
    "productivity",
    "data"
  ],
  "keywords": [
    "skill",
    "pdf",
    "generation",
    "markdown",
    "report",
    "PIL"
  ],
  "compatibility": {
    "minVersion": "0.9.0"
  },
  "components": {
    "skills": [
      "skills/pdf"
    ]
  },
  "permissions": {
    "network": [],
    "filesystem": [],
    "shell": false,
    "execute": true,
    "dangerousSkipPermissions": false,
    "permissionModelVersion": 2,
    "requested": [
      "sandbox.execute"
    ]
  },
  "validators": [
    {
      "id": "skill-pdf.validate_pdf",
      "entrypoint": "skills/pdf/scripts/validate_pdf.py",
      "runtime": "python3",
      "validationClass": "content_present",
      "protocol": "chainabit.pdf.validation/v1",
      "target": {
        "kind": "file",
        "extensions": [
          ".pdf"
        ]
      }
    }
  ],
  "diagnostics": [
    {
      "entrypoint": "skills/pdf/scripts/md_to_pdf.py",
      "inputErrorExitCodes": [
        1
      ]
    },
    {
      "entrypoint": "skills/pdf/scripts/report_pdf.py",
      "inputErrorExitCodes": [
        1
      ]
    },
    {
      "entrypoint": "skills/pdf/scripts/validate_pdf.py",
      "inputErrorExitCodes": [
        1
      ]
    }
  ],
  "produces": [
    ".pdf"
  ],
  "requires": {
    "python": [
      "weasyprint",
      "pypdf"
    ],
    "binaries": [
      "python3"
    ],
    "fonts": [
      "IBM Plex Sans"
    ]
  },
  "dependencies": {
    "required": {
      "python": [
        "weasyprint",
        "pypdf"
      ],
      "binaries": [
        "python3"
      ],
      "fonts": [
        "IBM Plex Sans"
      ]
    },
    "optional": {}
  },
  "artifactContract": {
    "formats": [
      {
        "format": "pdf",
        "outputShape": "file",
        "extension": ".pdf",
        "mimeType": "application/pdf",
        "validatorId": "skill-pdf.validate_pdf",
        "validatorProtocol": "chainabit.pdf.validation/v1",
        "minimumValidationClass": "content_present"
      }
    ],
    "generators": [
      {
        "id": "skill-pdf.markdown",
        "runtime": "python3",
        "entrypoint": "skills/pdf/scripts/md_to_pdf.py",
        "outputArgumentIndex": 3,
        "protocol": "chainabit.pdf.execution/v1",
        "formats": ["pdf"]
      },
      {
        "id": "skill-pdf.report",
        "runtime": "python3",
        "entrypoint": "skills/pdf/scripts/report_pdf.py",
        "outputArgumentIndex": 3,
        "protocol": "chainabit.pdf.execution/v1",
        "formats": ["pdf"]
      }
    ]
  },
  "typography": {
    "defaultFamily": "IBM Plex Sans",
    "userOverride": true,
    "fallbackFamilies": ["IBM Plex Sans Arabic"],
    "runtimeFamilyEnv": "CHAINABIT_ARTIFACT_FONT_FAMILY",
    "runtimeAssetDirEnv": "CHAINABIT_ARTIFACT_FONT_DIR"
  },
  "capabilities": {
    "declared": [
      {
        "id": "skill-pdf.core",
        "kind": "skill",
        "verifiedBehaviors": [
          "declared bundle behavior"
        ]
      }
    ],
    "requested": []
  }
}
