{
  "schemaVersion": 2,
  "id": "skill-docx",
  "name": "Word Document Skill",
  "version": "1.2.0",
  "description": "Builds real .docx documents from a JSON spec — headings, styled paragraphs, bulleted and numbered lists, tables and page breaks — and validates the result. Ships two Python scripts that run in the sandbox against the pre-installed python-docx; no network access at any point.",
  "author": {
    "name": "NEXUS Community"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/chainabit/plugins/tree/main/artifacts/skill-docx",
  "categories": [
    "productivity"
  ],
  "keywords": [
    "skill",
    "docx",
    "word",
    "document",
    "python-docx",
    "report",
    "resume"
  ],
  "compatibility": {
    "minVersion": "0.9.0"
  },
  "components": {
    "skills": [
      "skills/docx"
    ]
  },
  "permissions": {
    "network": [],
    "filesystem": [],
    "shell": false,
    "execute": true,
    "dangerousSkipPermissions": false,
    "permissionModelVersion": 2,
    "requested": [
      "sandbox.execute"
    ]
  },
  "validators": [
    {
      "id": "skill-docx.validate_docx",
      "entrypoint": "skills/docx/scripts/validate_docx.py",
      "runtime": "python3",
      "validationClass": "content_present",
      "protocol": "chainabit.docx.validation/v1",
      "target": {
        "kind": "file",
        "extensions": [
          ".docx"
        ]
      }
    }
  ],
  "diagnostics": [
    {
      "entrypoint": "skills/docx/scripts/build_docx.py",
      "inputErrorExitCodes": [
        1
      ]
    },
    {
      "entrypoint": "skills/docx/scripts/validate_docx.py",
      "inputErrorExitCodes": [
        1
      ]
    }
  ],
  "produces": [
    ".docx"
  ],
  "requires": {
    "python": [
      "python-docx"
    ],
    "binaries": [
      "python3"
    ],
    "fonts": ["IBM Plex Sans"]
  },
  "dependencies": {
    "required": {
      "python": [
        "python-docx"
      ],
      "binaries": [
        "python3"
      ],
      "fonts": ["IBM Plex Sans"]
    },
    "optional": {}
  },
  "artifactContract": {
    "formats": [
      {
        "format": "docx",
        "outputShape": "file",
        "extension": ".docx",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "validatorId": "skill-docx.validate_docx",
        "validatorProtocol": "chainabit.docx.validation/v1",
        "minimumValidationClass": "content_present"
      }
    ],
    "generators": [
      {
        "id": "skill-docx.document",
        "runtime": "python3",
        "entrypoint": "skills/docx/scripts/build_docx.py",
        "outputArgumentIndex": 3,
        "protocol": "chainabit.docx.execution/v1",
        "formats": ["docx"]
      }
    ]
  },
  "typography": {
    "defaultFamily": "IBM Plex Sans",
    "userOverride": true,
    "fallbackFamilies": ["IBM Plex Sans Arabic"],
    "runtimeFamilyEnv": "CHAINABIT_ARTIFACT_FONT_FAMILY",
    "runtimeAssetDirEnv": "CHAINABIT_ARTIFACT_FONT_DIR"
  },
  "capabilities": {
    "declared": [
      {
        "id": "skill-docx.core",
        "kind": "skill",
        "verifiedBehaviors": [
          "declared bundle behavior"
        ]
      }
    ],
    "requested": []
  }
}
