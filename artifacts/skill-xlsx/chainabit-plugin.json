{
  "schemaVersion": 2,
  "id": "skill-xlsx",
  "name": "Excel Workbook Skill",
  "version": "1.2.0",
  "description": "Builds real .xlsx workbooks from a JSON spec — typed cells, a styled header row, column widths, and number formats — and validates the result. Ships two Python scripts that run in the sandbox against the pre-installed openpyxl; no network access at any point.",
  "author": {
    "name": "NEXUS Community"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/chainabit/plugins/tree/main/artifacts/skill-xlsx",
  "categories": [
    "productivity",
    "data"
  ],
  "keywords": [
    "skill",
    "xlsx",
    "excel",
    "spreadsheet",
    "openpyxl",
    "tables",
    "data"
  ],
  "compatibility": {
    "minVersion": "0.9.0"
  },
  "components": {
    "skills": [
      "skills/xlsx"
    ]
  },
  "permissions": {
    "network": [],
    "filesystem": [],
    "shell": false,
    "execute": true,
    "dangerousSkipPermissions": false,
    "permissionModelVersion": 2,
    "requested": [
      "sandbox.execute"
    ]
  },
  "validators": [
    {
      "id": "skill-xlsx.validate_xlsx",
      "entrypoint": "skills/xlsx/scripts/validate_xlsx.py",
      "runtime": "python3",
      "validationClass": "content_present",
      "protocol": "chainabit.xlsx.validation/v1",
      "target": {
        "kind": "file",
        "extensions": [
          ".xlsx"
        ]
      }
    }
  ],
  "diagnostics": [
    {
      "entrypoint": "skills/xlsx/scripts/build_xlsx.py",
      "inputErrorExitCodes": [
        1
      ]
    },
    {
      "entrypoint": "skills/xlsx/scripts/validate_xlsx.py",
      "inputErrorExitCodes": [
        1
      ]
    }
  ],
  "produces": [
    ".xlsx"
  ],
  "requires": {
    "python": [
      "openpyxl"
    ],
    "binaries": [
      "python3"
    ],
    "fonts": ["IBM Plex Sans"]
  },
  "dependencies": {
    "required": {
      "python": [
        "openpyxl"
      ],
      "binaries": [
        "python3"
      ],
      "fonts": ["IBM Plex Sans"]
    },
    "optional": {}
  },
  "artifactContract": {
    "formats": [
      {
        "format": "xlsx",
        "outputShape": "file",
        "extension": ".xlsx",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "validatorId": "skill-xlsx.validate_xlsx",
        "validatorProtocol": "chainabit.xlsx.validation/v1",
        "minimumValidationClass": "content_present"
      }
    ],
    "generators": [
      {
        "id": "skill-xlsx.workbook",
        "runtime": "python3",
        "entrypoint": "skills/xlsx/scripts/build_xlsx.py",
        "outputArgumentIndex": 3,
        "protocol": "chainabit.xlsx.execution/v1",
        "formats": ["xlsx"]
      }
    ]
  },
  "typography": {
    "defaultFamily": "IBM Plex Sans",
    "userOverride": true,
    "fallbackFamilies": ["IBM Plex Sans Arabic"],
    "runtimeFamilyEnv": "CHAINABIT_ARTIFACT_FONT_FAMILY",
    "runtimeAssetDirEnv": "CHAINABIT_ARTIFACT_FONT_DIR"
  },
  "capabilities": {
    "declared": [
      {
        "id": "skill-xlsx.core",
        "kind": "skill",
        "verifiedBehaviors": [
          "declared bundle behavior"
        ]
      }
    ],
    "requested": []
  }
}
