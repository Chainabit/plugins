{
  "schemaVersion": 2,
  "id": "skill-pptx",
  "name": "Presentation Skill",
  "version": "1.2.0",
  "description": "Builds real .pptx presentations from a JSON spec using four brand-safe layouts — title, content, comparison, closing — with a palette and type scale checked against WCAG AA, and validates OOXML structure, relationships, typography, empty slides, overflowing text, low contrast and over-dense bullets. PDF delivery remains owned by the PDF capability and its validator.",
  "author": {
    "name": "NEXUS Community"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/chainabit/plugins/tree/main/artifacts/skill-pptx",
  "categories": [
    "productivity",
    "data"
  ],
  "keywords": [
    "skill",
    "pptx",
    "powerpoint",
    "presentation",
    "slides",
    "deck",
    "python-pptx",
    "design"
  ],
  "compatibility": {
    "minVersion": "0.9.0"
  },
  "components": {
    "skills": [
      "skills/pptx"
    ]
  },
  "permissions": {
    "network": [],
    "filesystem": [],
    "shell": false,
    "execute": true,
    "dangerousSkipPermissions": false,
    "permissionModelVersion": 2,
    "requested": [
      "sandbox.execute"
    ]
  },
  "validators": [
    {
      "id": "skill-pptx.validate_pptx",
      "entrypoint": "skills/pptx/scripts/validate_pptx.py",
      "runtime": "python3",
      "validationClass": "content_present",
      "protocol": "chainabit.pptx.validation/v1",
      "target": {
        "kind": "file",
        "extensions": [
          ".pptx"
        ]
      }
    }
  ],
  "diagnostics": [
    {
      "entrypoint": "skills/pptx/scripts/deck_pptx.py",
      "inputErrorExitCodes": [
        1
      ]
    },
    {
      "entrypoint": "skills/pptx/scripts/deck_pdf.py",
      "inputErrorExitCodes": [
        1
      ]
    },
    {
      "entrypoint": "skills/pptx/scripts/validate_pptx.py",
      "inputErrorExitCodes": [
        1
      ]
    }
  ],
  "produces": [
    ".pptx"
  ],
  "requires": {
    "python": [
      "python-pptx",
      "reportlab"
    ],
    "binaries": [
      "python3"
    ],
    "fonts": [
      "IBM Plex Sans"
    ]
  },
  "dependencies": {
    "required": {
      "python": [
        "python-pptx",
        "reportlab"
      ],
      "binaries": [
        "python3"
      ],
      "fonts": [
        "IBM Plex Sans"
      ]
    },
    "optional": {}
  },
  "artifactContract": {
    "formats": [
      {
        "format": "pptx",
        "outputShape": "file",
        "extension": ".pptx",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "validatorId": "skill-pptx.validate_pptx",
        "validatorProtocol": "chainabit.pptx.validation/v1",
        "minimumValidationClass": "content_present"
      }
    ],
    "generators": [
      {
        "id": "skill-pptx.deck",
        "runtime": "python3",
        "entrypoint": "skills/pptx/scripts/deck_pptx.py",
        "outputArgumentIndex": 3,
        "protocol": "chainabit.pptx.execution/v1",
        "formats": ["pptx"]
      }
    ]
  },
  "typography": {
    "defaultFamily": "IBM Plex Sans",
    "userOverride": true,
    "fallbackFamilies": ["IBM Plex Sans Arabic"],
    "runtimeFamilyEnv": "CHAINABIT_ARTIFACT_FONT_FAMILY",
    "runtimeAssetDirEnv": "CHAINABIT_ARTIFACT_FONT_DIR"
  },
  "capabilities": {
    "declared": [
      {
        "id": "skill-pptx.core",
        "kind": "skill",
        "verifiedBehaviors": [
          "declared bundle behavior"
        ]
      }
    ],
    "requested": []
  }
}
