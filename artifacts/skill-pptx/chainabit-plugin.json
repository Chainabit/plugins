{
  "schemaVersion": 2,
  "id": "skill-pptx",
  "name": "Presentation Skill",
  "version": "1.4.2",
  "description": "Builds real .pptx presentations from a JSON spec using eight brand-safe layouts \u2014 title, content, comparison, closing, and four that carry a figure: a hero-image cover, an image-and-text slide, a full-bleed image slide and a chart slide that plots native bar, line or pie data \u2014 with a palette and type scale checked against WCAG AA. Pictures cross an audited image boundary: local files only, inside the spec's own directory, format-, size- and pixel-bounded. Renders the same spec as a matching PDF through a registered PDF generator, and validates OOXML structure, relationships, typography, empty slides, overflowing text, low contrast, over-dense bullets, and how many pictures and charts the deck embeds. The PDF format and its validator remain owned by the composed PDF capability.",
  "author": {
    "name": "NEXUS Community"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/chainabit/plugins/tree/main/artifacts/skill-pptx",
  "categories": [
    "productivity",
    "data"
  ],
  "keywords": [
    "skill",
    "pptx",
    "powerpoint",
    "presentation",
    "slides",
    "deck",
    "python-pptx",
    "design",
    "chart",
    "image"
  ],
  "compatibility": {
    "minVersion": "0.9.0"
  },
  "components": {
    "skills": [
      "skills/pptx"
    ]
  },
  "composition": {
    "requires": [
      "skill-brand-defaults",
      "skill-pdf"
    ],
    "role": "capability"
  },
  "permissions": {
    "network": [],
    "filesystem": [],
    "shell": false,
    "execute": true,
    "dangerousSkipPermissions": false,
    "permissionModelVersion": 2,
    "requested": [
      "sandbox.execute"
    ]
  },
  "validators": [
    {
      "id": "skill-pptx.validate_pptx",
      "entrypoint": "skills/pptx/scripts/validate_pptx.py",
      "runtime": "python3",
      "validationClass": "content_present",
      "protocol": "chainabit.pptx.validation/v1",
      "target": {
        "kind": "file",
        "extensions": [
          ".pptx"
        ]
      }
    }
  ],
  "diagnostics": [
    {
      "entrypoint": "skills/pptx/scripts/deck_pptx.py",
      "inputErrorExitCodes": [
        1
      ]
    },
    {
      "entrypoint": "skills/pptx/scripts/deck_pdf.py",
      "inputErrorExitCodes": [
        1
      ]
    },
    {
      "entrypoint": "skills/pptx/scripts/validate_pptx.py",
      "inputErrorExitCodes": [
        1
      ]
    }
  ],
  "produces": [
    ".pptx",
    ".pdf"
  ],
  "requires": {
    "python": [
      "python-pptx",
      "reportlab",
      "Pillow"
    ],
    "binaries": [
      "python3"
    ],
    "fonts": [
      "IBM Plex Sans"
    ]
  },
  "dependencies": {
    "required": {
      "python": [
        "python-pptx",
        "reportlab",
        "Pillow"
      ],
      "binaries": [
        "python3"
      ],
      "fonts": [
        "IBM Plex Sans"
      ]
    },
    "optional": {}
  },
  "artifactContract": {
    "formats": [
      {
        "format": "pptx",
        "outputShape": "file",
        "extension": ".pptx",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "validatorId": "skill-pptx.validate_pptx",
        "validatorProtocol": "chainabit.pptx.validation/v1",
        "minimumValidationClass": "content_present"
      }
    ],
    "generators": [
      {
        "id": "skill-pptx.deck",
        "runtime": "python3",
        "entrypoint": "skills/pptx/scripts/deck_pptx.py",
        "outputArgumentIndex": 3,
        "protocol": "chainabit.pptx.execution/v1",
        "formats": [
          "pptx"
        ]
      },
      {
        "id": "skill-pptx.deck_pdf",
        "runtime": "python3",
        "entrypoint": "skills/pptx/scripts/deck_pdf.py",
        "outputArgumentIndex": 3,
        "protocol": "chainabit.pdf.execution/v1",
        "formats": [
          "pdf"
        ]
      }
    ]
  },
  "typography": {
    "defaultFamily": "IBM Plex Sans",
    "userOverride": true,
    "fallbackFamilies": [
      "IBM Plex Sans Arabic"
    ],
    "runtimeFamilyEnv": "CHAINABIT_ARTIFACT_FONT_FAMILY",
    "runtimeAssetDirEnv": "CHAINABIT_ARTIFACT_FONT_DIR"
  },
  "runtime": {
    "contractVersion": 2,
    "interpreter": "python3",
    "cwd": "workspace-root",
    "assets": [
      {
        "id": "fonts.ibm-plex",
        "envVar": "CHAINABIT_ARTIFACT_FONT_DIR",
        "defaultPath": "/opt/chainabit/artifact-fonts/ibm-plex-sans",
        "required": true
      }
    ]
  },
  "capabilities": {
    "declared": [
      {
        "id": "skill-pptx.core",
        "kind": "skill",
        "verifiedBehaviors": [
          "declared bundle behavior"
        ]
      }
    ],
    "requested": []
  }
}
