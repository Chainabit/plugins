{
  "schemaVersion": 2,
  "id": "skill-xlsx",
  "name": "Excel Workbook Skill",
  "version": "1.1.0",
  "description": "Builds real .xlsx workbooks from a JSON spec \u2014 typed cells, a styled header row, column widths, and number formats \u2014 and validates the result. Ships two Python scripts that run in the sandbox against the pre-installed openpyxl; no network access at any point.",
  "author": {
    "name": "NEXUS Community"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/chainabit/plugins/tree/main/skill-xlsx",
  "categories": [
    "productivity",
    "data"
  ],
  "keywords": [
    "skill",
    "xlsx",
    "excel",
    "spreadsheet",
    "openpyxl",
    "tables",
    "data"
  ],
  "compatibility": {
    "minVersion": "0.9.0"
  },
  "components": {
    "skills": [
      "skills/xlsx"
    ]
  },
  "permissions": {
    "network": [],
    "filesystem": [],
    "shell": false,
    "execute": true,
    "dangerousSkipPermissions": false
  },
  "validators": [
    {
      "id": "skill-xlsx.validate_xlsx",
      "entrypoint": "skills/xlsx/scripts/validate_xlsx.py",
      "runtime": "python3",
      "validationClass": "content_present",
      "target": {
        "kind": "file",
        "extensions": [
          ".xlsx"
        ]
      }
    }
  ],
  "diagnostics": [
    {
      "entrypoint": "skills/xlsx/scripts/build_xlsx.py",
      "inputErrorExitCodes": [
        1
      ]
    },
    {
      "entrypoint": "skills/xlsx/scripts/validate_xlsx.py",
      "inputErrorExitCodes": [
        1
      ]
    }
  ],
  "produces": [
    ".xlsx"
  ],
  "requires": {
    "python": [
      "openpyxl"
    ],
    "binaries": [
      "python3"
    ],
    "fonts": []
  }
}
