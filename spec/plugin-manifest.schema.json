{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chainabit/plugins/spec/plugin-manifest.schema.json",
  "title": "Chainabit Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "components", "permissions"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1, 2] },
    "id": { "type": "string", "pattern": "^(skill|agent|provider|persona|hook|plugin)-[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "$ref": "#/$defs/semver" },
    "description": { "type": "string", "maxLength": 2000 },
    "author": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "object", "additionalProperties": false, "required": ["name"], "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" }
        } }
      ]
    },
    "license": { "type": "string", "minLength": 1 },
    "homepage": { "type": "string", "format": "uri" },
    "categories": { "$ref": "#/$defs/stringArray" },
    "keywords": { "$ref": "#/$defs/stringArray" },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "properties": { "minVersion": { "$ref": "#/$defs/semver" } }
    },
    "components": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "skills": { "$ref": "#/$defs/pathArray" },
        "agents": { "$ref": "#/$defs/pathArray" },
        "commands": { "$ref": "#/$defs/pathArray" },
        "hooks": { "type": "array", "items": { "type": "object" } },
        "mcpServers": { "type": "array", "items": { "type": "object" } },
        "providers": { "type": "array", "items": { "type": "object" } }
      }
    },
    "composition": {
      "type": "object", "additionalProperties": false,
      "required": ["requires"],
      "properties": {
        "requires": { "type": "array", "items": { "$ref": "composition.schema.json#/$defs/requirement" } },
        "role": { "type": "string", "minLength": 1 },
        "aliasOf": { "type": "string" }
      }
    },
    "permissions": { "$ref": "permissions.schema.json" },
    "validators": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "entrypoint", "runtime", "validationClass", "protocol", "target"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "entrypoint": { "$ref": "#/$defs/relativePath" },
          "runtime": { "type": "string", "minLength": 1 },
          "validationClass": { "type": "string", "minLength": 1 },
          "protocol": { "type": "string", "pattern": "^chainabit\\.[a-z0-9.-]+\\.validation/v[1-9][0-9]*$" },
          "target": { "type": "object" }
        }
      }
    },
    "diagnostics": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["entrypoint", "inputErrorExitCodes"],
        "properties": {
          "entrypoint": { "$ref": "#/$defs/relativePath" },
          "inputErrorExitCodes": { "type": "array", "items": { "type": "integer" }, "uniqueItems": true }
        }
      }
    },
    "produces": { "$ref": "#/$defs/stringArray" },
    "requires": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "python": { "$ref": "#/$defs/stringArray" },
        "binaries": { "$ref": "#/$defs/stringArray" },
        "fonts": { "$ref": "#/$defs/stringArray" }
      }
    },
    "dependencies": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": { "type": "object" },
        "optional": { "type": "object" }
      }
    },
    "artifactContract": {
      "type": "object", "additionalProperties": false,
      "required": ["formats", "generators"],
      "properties": {
        "formats": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["format", "outputShape", "mimeType", "validatorId", "minimumValidationClass"],
            "properties": {
              "format": { "type": "string", "minLength": 1 },
              "outputShape": { "enum": ["file", "tree"] },
              "extension": { "type": "string", "pattern": "^\\.[A-Za-z0-9]+$" },
              "mimeType": { "type": "string", "minLength": 3 },
              "validatorId": { "type": "string", "minLength": 1 },
              "validatorProtocol": { "type": "string", "minLength": 1 },
              "minimumValidationClass": { "enum": ["container", "content_present", "semantic"] }
            }
          }
        },
        "generators": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "runtime", "entrypoint", "outputArgumentIndex", "protocol", "formats"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "runtime": { "enum": ["python3"] },
              "entrypoint": { "$ref": "#/$defs/relativePath" },
              "outputArgumentIndex": { "type": "integer", "minimum": 0 },
              "protocol": { "type": "string", "minLength": 1 },
              "formats": { "$ref": "#/$defs/stringArray" }
            }
          }
        }
      }
    },
    "typography": {
      "type": "object", "additionalProperties": false,
      "required": ["defaultFamily", "userOverride", "fallbackFamilies", "runtimeFamilyEnv", "runtimeAssetDirEnv"],
      "properties": {
        "defaultFamily": { "type": "string", "minLength": 1 },
        "userOverride": { "type": "boolean" },
        "fallbackFamilies": { "$ref": "#/$defs/stringArray" },
        "runtimeFamilyEnv": { "type": "string", "minLength": 1 },
        "runtimeAssetDirEnv": { "type": "string", "minLength": 1 }
      }
    },
    "runtime": {
      "description": "What this package needs from an execution environment, declared rather than assumed. Without it a package's only way to state a runtime requirement was to hardcode a host path in a script or in prose, which made the package a second, undocumented filesystem API for whoever ran it.",
      "type": "object", "additionalProperties": false,
      "required": ["contractVersion", "interpreter", "cwd"],
      "properties": {
        "contractVersion": {
          "description": "1 (assumed when this block is absent) means SKILL.md addresses bundled files by paths that are only valid relative to some root the package does not control. 2 means it addresses them through {{SKILL_DIR}}, which the host substitutes for the location it actually materialized the bundle at. A host that cannot honour a version must refuse the package at registration rather than at first command.",
          "type": "integer", "enum": [1, 2]
        },
        "interpreter": {
          "description": "How a bundled script is invoked. Bundled scripts are published non-executable, so the shebang is decorative and the interpreter is not inferable from the file.",
          "type": "string", "enum": ["python3", "node"]
        },
        "cwd": {
          "description": "What the working directory is when the host runs a declared entrypoint. 'workspace-root' means the user's writable tree -- so outputs are named relative to it and never by an absolute host path.",
          "type": "string", "enum": ["workspace-root"]
        },
        "assets": {
          "description": "Host-provided resources the scripts read. Each names the environment variable the host sets and the path the package falls back to, so the dependency is reviewable instead of buried in a default argument.",
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "envVar", "defaultPath", "required"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)*$" },
              "envVar": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
              "defaultPath": { "type": "string", "pattern": "^/" },
              "required": { "type": "boolean" }
            }
          }
        }
      }
    },
    "capabilities": { "$ref": "capabilities.schema.json" },
    "installation": { "$ref": "installation.schema.json" }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" },
    "stringArray": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*\\.\\.)(?!.*//)[A-Za-z0-9_][A-Za-z0-9._/-]*$" },
    "pathArray": { "type": "array", "items": { "$ref": "#/$defs/relativePath" }, "uniqueItems": true }
  }
}
