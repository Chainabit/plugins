{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chainabit.com/spec/application-capability.schema.json",
  "title": "Application capability expertise",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "planProtocol",
    "technologyId",
    "operations",
    "previewKinds",
    "dependencyPolicy"
  ],
  "properties": {
    "protocolVersion": {
      "const": "chainabit.application-capability/v1"
    },
    "planProtocol": {
      "const": "chainabit.application-plan/v1"
    },
    "technologyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "inspect",
          "build",
          "test",
          "preview",
          "package"
        ]
      }
    },
    "previewKinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "static",
          "runtime"
        ]
      }
    },
    "dependencyPolicy": {
      "const": "offline-only"
    }
  }
}
