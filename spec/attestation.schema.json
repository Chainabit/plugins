{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chainabit/plugins/spec/attestation.schema.json",
  "title": "Chainabit Plugin Attestation",
  "description": "An externally owned release attestation. Presence does not imply publisher trust or a security review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "subject", "publisher", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["pluginId", "version", "revision", "packageSha256"],
      "properties": {
        "pluginId": { "type": "string", "pattern": "^(skill|agent|provider|persona|hook|plugin)-[a-z0-9]+(-[a-z0-9]+)*$" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "packageSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "publisher": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "keyId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "keyId": { "type": "string", "minLength": 1 }
      }
    },
    "signature": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9+/=]+$" }
      }
    },
    "provenance": { "type": "object" }
  }
}
