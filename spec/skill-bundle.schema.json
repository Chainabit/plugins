{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chainabit.com/spec/skill-bundle.schema.json",
  "type": "object",
  "required": ["files"],
  "properties": {
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["path", "type", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9._/-]*$" },
          "type": { "enum": ["instructions", "references", "scripts", "assets", "metadata"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 524288 }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
