{
  "schemaVersion": 2,
  "id": "skill-docx",
  "name": "Word Document Skill",
  "version": "1.0.0",
  "description": "Builds real .docx documents from a JSON spec — headings, styled paragraphs, bulleted and numbered lists, tables and page breaks — and validates the result. Ships two Python scripts that run in the sandbox against the pre-installed python-docx; no network access at any point.",
  "author": {
    "name": "NEXUS Community"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/chainabit/plugins/tree/main/skill-docx",
  "categories": [
    "productivity"
  ],
  "keywords": [
    "skill",
    "docx",
    "word",
    "document",
    "python-docx",
    "report",
    "resume"
  ],
  "compatibility": {
    "minVersion": "0.9.0"
  },
  "components": {
    "skills": [
      "skills/docx"
    ]
  },
  "permissions": {
    "network": [],
    "filesystem": [],
    "shell": false,
    "execute": true,
    "dangerousSkipPermissions": false
  },
  "validators": [
    {
      "id": "skill-docx.validate_docx",
      "entrypoint": "skills/docx/scripts/validate_docx.py",
      "runtime": "python3",
      "validationClass": "content_present",
      "target": {
        "kind": "file",
        "extensions": [
          ".docx"
        ]
      }
    }
  ]
}
