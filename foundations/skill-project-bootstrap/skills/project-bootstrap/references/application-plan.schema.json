{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chainabit.com/spec/application-plan.schema.json",
  "title": "Application execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "capability",
    "phases",
    "preview",
    "verification"
  ],
  "properties": {
    "protocolVersion": {
      "const": "chainabit.application-plan/v1"
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "revision",
        "packageSha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "packageSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prepare",
        "build",
        "test"
      ],
      "properties": {
        "prepare": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "build": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "test": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/command"
          }
        }
      }
    },
    "preview": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "outputPath",
            "entryPath"
          ],
          "properties": {
            "kind": {
              "const": "static"
            },
            "outputPath": {
              "$ref": "#/$defs/directoryPath"
            },
            "entryPath": {
              "$ref": "#/$defs/relativePath"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "command",
            "port",
            "healthPath"
          ],
          "properties": {
            "kind": {
              "const": "runtime"
            },
            "command": {
              "$ref": "#/$defs/command"
            },
            "port": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535
            },
            "healthPath": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^/(?!/)"
            },
            "env": {
              "type": "object",
              "maxProperties": 16,
              "propertyNames": {
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 1024
              }
            }
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "paths"
      ],
      "properties": {
        "kind": {
          "enum": [
            "browser",
            "http"
          ]
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^/(?!/)"
          }
        },
        "requiredSelectors": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "cwd"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "cwd": {
          "$ref": "#/$defs/directoryPath"
        }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[/\\x00-\\x1f\\x7f]$)[^\\x00-\\x1f\\x7f]+$"
    },
    "directoryPath": {
      "oneOf": [
        {
          "const": "."
        },
        {
          "$ref": "#/$defs/relativePath"
        }
      ]
    }
  }
}
